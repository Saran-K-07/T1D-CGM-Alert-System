<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alert_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:id="@+id/alert_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LOW GLUCOSE ALERT!"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center" />

    <TextView
        android:id="@+id/sgv_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current SGV: --"
        android:textSize="32sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/trend_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trend: --"
        android:textSize="24sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="64dp"
        android:background="@android:color/darker_gray"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Slide to Dismiss"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:gravity="center" />

        <SeekBar
            android:id="@+id/dismiss_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:thumb="@android:drawable/ic_lock_idle_lock"
            android:progressDrawable="@android:drawable/progress_horizontal"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</LinearLayout>